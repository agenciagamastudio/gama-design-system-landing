# Google Drive Integration (OBRIGATÓRIO)
# Copie o ID da URL: drive.google.com/drive/folders/[ESTE_ID]
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=seu_folder_id_aqui

# Google API Key (RECOMENDADO - obtém em https://console.cloud.google.com)
# Sem ela, o site funciona com fallback de fotos demo
NEXT_PUBLIC_GOOGLE_API_KEY=sua_api_key_aqui
